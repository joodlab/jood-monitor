  "info": {
    "title": "Jood Monitor",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/clusters": {
      "post": {
        "operationId": "createCluster",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClusterInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterCreated"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope or origin rejected"
          }
        },
        "security": [
          {
            "operator": []
          }
        ]
      }
    },
    "/api/v1/clusters/{id}/enrollment": {
      "post": {
        "operationId": "enrollment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterCreated"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope or origin rejected"
          },
          "404": {
            "description": "Cluster missing"
          },
          "409": {
            "description": "Active credential must be revoked first"
          }
        },
        "security": [
          {
            "operator": []
          }
        ]
      }
