{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "collections/*": ["./.source/*"]
    },
    "types": ["vite/client", "@cloudflare/workers-types", "node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "cloudflare.config.ts",
    "tests",
    ".source/**/*.ts",
    "source.config.ts"
  ]
}
