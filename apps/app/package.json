{
  "name": "@jood-monitor/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3040",
    "build": "node ../../scripts/release/licenses.mjs public/third-party-licenses.txt && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:emit": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate:local": "node ../../scripts/db/migrate.mjs --local",
    "db:migrate:remote": "node ../../scripts/db/migrate.mjs --remote",
    "deploy": "node ../../scripts/cloudflare/deploy.mjs app",
    "test:worker": "node scripts/test-worker.mjs",
    "test:start": "node scripts/test-start.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@fontsource-variable/geist": "5.2.8",
    "@jood-monitor/api-client": "workspace:*",
    "@jood-monitor/ui": "workspace:*",
    "@prisma/orm-sqlite": "8.0.0-rc.17",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-form-devtools": "0.2.27",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.1",
    "@tanstack/react-table": "8.21.3",
    "@xyflow/react": "12.10.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "5.20261013.1",
    "@prisma/cli-engine": "0.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.2-beta",
    "prisma": "8.0.0-rc.22",
    "seroval": "1.6.9",
    "vite": "8.2.1",
    "cf": "1.0.0-beta.12"
  }
