{
  "name": "jood-monitor",
  "main": "apps/app/src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jood-monitor",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/app/src/db/migrations/d1"
    }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVES", "bucket_name": "jood-monitor-archives" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CLUSTERS", "class_name": "ClusterState" },
      { "name": "STREAMS", "class_name": "WorkspaceStream" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClusterState", "WorkspaceStream"] }
  ],
  "queues": {
    "producers": [{ "binding": "HISTORY", "queue": "jood-monitor-history" }],
    "consumers": [
      {
        "queue": "jood-monitor-history",
        "dead_letter_queue": "jood-monitor-history-failed",
        "max_batch_size": 10,
        "max_retries": 10,
        "max_concurrency": 2
      }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "version_metadata": { "binding": "RELEASE" },
  "vars": { "VERSION": "0.1.0" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
